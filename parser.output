Grammar

    0 $accept: program $end

    1 program: global_decl_statement_list func_def_list
    2        | func_def_list

    3 global_decl_statement_list: global_decl_statement_list var_decl_stmt
    4                           | global_decl_statement_list func_decl
    5                           | var_decl_stmt
    6                           | func_decl

    7 func_decl: func_header LEFT_ROUND_BRACKET formal_param_list RIGHT_ROUND_BRACKET SEMICOLON
    8          | func_header LEFT_ROUND_BRACKET RIGHT_ROUND_BRACKET SEMICOLON

    9 func_def_list: func_def

   10 func_header: named_type NAME

   11 func_def: func_header LEFT_ROUND_BRACKET formal_param_list RIGHT_ROUND_BRACKET LEFT_CURLY_BRACKET optional_local_var_decl_stmt_list statement_list RIGHT_CURLY_BRACKET
   12         | func_header LEFT_ROUND_BRACKET RIGHT_ROUND_BRACKET LEFT_CURLY_BRACKET optional_local_var_decl_stmt_list statement_list RIGHT_CURLY_BRACKET

   13 formal_param_list: formal_param_list COMMA formal_param
   14                  | formal_param

   15 formal_param: param_type NAME

   16 param_type: INTEGER
   17           | FLOAT
   18           | BOOL
   19           | STRING

   20 statement_list: statement_list statement
   21               | ε

   22 statement: assignment_statement
   23          | print_statement
   24          | read_statement

   25 optional_local_var_decl_stmt_list: ε
   26                                  | var_decl_stmt_list

   27 var_decl_stmt_list: var_decl_stmt
   28                   | var_decl_stmt_list var_decl_stmt

   29 var_decl_stmt: named_type var_decl_item_list SEMICOLON

   30 var_decl_item_list: var_decl_item_list COMMA var_decl_item
   31                   | var_decl_item

   32 var_decl_item: NAME

   33 named_type: INTEGER
   34           | FLOAT
   35           | VOID
   36           | STRING
   37           | BOOL

   38 assignment_statement: variable_as_operand ASSIGN expression SEMICOLON

   39 print_statement: WRITE expression SEMICOLON

   40 read_statement: READ variable_name SEMICOLON

   41 expression: expression PLUS expression
   42           | expression MINUS expression
   43           | expression MULT expression
   44           | expression DIV expression
   45           | MINUS expression
   46           | LEFT_ROUND_BRACKET expression RIGHT_ROUND_BRACKET
   47           | variable_as_operand
   48           | constant_as_operand

   49 variable_as_operand: variable_name

   50 variable_name: NAME

   51 constant_as_operand: INTEGER_NUMBER
   52                    | DOUBLE_NUMBER
   53                    | STRING_CONSTANT


