
	.data
global_:	.word 0
	.text 			# The .text assembler directive indicates
	.globl main		# The following is the code (as opposed to data)
main:                    # .globl makes main know to the outside of the program.
# Prologue begins
	sw $ra, 0($sp)          # Save the return address
	sw $fp, -4($sp)         # Save the frame pointer
	sub $fp, $sp, 4         # Update the frame pointer
	sub $sp, $sp, 24        # Make space for the locals
# Prologue ends

	li $v0, 5               # Loading 5 in v0 to indicate syscall to read integer value
	syscall
	sw $v0, -4($fp)         # Moving the read value from register v0
	li $v0, 5               # Loading 5 in v0 to indicate syscall to read integer value
	syscall
	sw $v0, -8($fp)         # Moving the read value from register v0
	lw $v0, -4($fp)         # Source:num1_
	lw $t1, -8($fp)         # Source:num2_
	sge $t0, $v0, $t1       # Comparing $v0 and $t1, Result in $t0
	lw $v0, -4($fp)         # Source:num1_
	lw $t2, -8($fp)         # Source:num2_
	mul $t1, $v0, $t2       # Result: $t1, Opd1: $v0, Opd2:$t2
	lw $v0, -4($fp)         # Source:num1_
	lw $t3, -8($fp)         # Source:num2_
	add $t2, $v0, $t3       # Result: $t2, Opd1: $v0, Opd2:$t3
	sgt $v0, $t1, $t2       # Comparing $t1 and $t2, Result in $v0
	or $t1, $t0, $v0        # Result: $t1, Opd1: $t0, Opd2:$v0
	xori $v0, $t1, 1        # Result: $v0, Opd1: $t1
	bgtz $v0, Label0
	lw $v0, -4($fp)         # Source:num1_
	sw $v0, -16($fp)        # Dest: $v0
	j Label1
Label0:
	lw $v0, -8($fp)         # Source:num2_
	sw $v0, -16($fp)        # Dest: $v0
Label1:
	lw $v0, -16($fp)        # Source:stemp0
	sw $v0, -12($fp)        # Dest: $v0
	li $v0, 1               # Loading 1 in v0 to indicate syscall to print integer value
	lw $a0, -12($fp)        # Moving the value to be printed into register a0
	syscall
epilogue_main:
	add $sp, $sp, 24        # Increment stack pointer for local variables
	lw $fp, -4($sp)         # Set $fp to $sp-4
	lw $ra, 0($sp)          # Save ra
	jr $ra                  # Jump back to the called procedure
# Epilogue Ends

